# ── LLM（变量名保留 OPENAI_*，实际走 DeepSeek 官方兼容接口）─────────────
OPENAI_API_KEY=sk-你的DeepSeek密钥
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=30
LLM_STRUCTURED_METHOD=json_mode
LLM_DISABLE_THINKING=true
# Agent-Loop 的 LangGraph 最大执行步数；正常流程一般不需要修改。
AGENT_RECURSION_LIMIT=12

# ── Embedding（硅基流动；openai 表示兼容协议，不是 OpenAI 模型）────────
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=sk-你的硅基流动密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RERANK_ENABLED=false

# ── Agent 会话持久化 + 混合检索权重（可选，一般不用改）─────────────────────
# 超过这么多天没有新消息的会话，AI 服务启动时自动清理。
SESSION_TTL_DAYS=7
# 语义检索（pgvector 余弦相似度）与关键词检索（BM25）融合时的权重，两者之和建议为 1。
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

# ── 备用聊天 LLM（硅基流动）──────────────────────────────────────────────
# 用途：DeepSeek 官方报错/超时时自动切换的兜底，靠 LangChain
# 的 with_fallbacks 实现——主力恢复正常后无需改配置，会自动继续优先用主力。
# LLM_FORCE_FALLBACK=true 则跳过主力，直接强制走这里（用于主力已知不可用时）。
LLM_FORCE_FALLBACK=false
LLM_FALLBACK_API_KEY=sk-你的硅基流动密钥
LLM_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1
LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_FALLBACK_STRUCTURED_METHOD=json_mode

# ── OCR（图片版简历 PNG/JPG 识别文字，可选，一般不用改）───────────────────
# 默认复用上面 EMBEDDING_API_KEY / EMBEDDING_BASE_URL（同一硅基流动账号）。
# 首选 DeepSeek-OCR（实测最快）；失败/超时再换 Qwen3-VL-8B、PaddleOCR-VL-1.5。
OCR_ENABLED=true
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_FALLBACK_MODELS=Qwen/Qwen3-VL-8B-Instruct,PaddlePaddle/PaddleOCR-VL-1.5
OCR_API_KEY=
OCR_BASE_URL=

# ── JWT（Java / Python 两端必须一致，否则登录态无法互认）───────────────────
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=把你的32字节Hex密钥粘贴在这里
# Java 调 Python 内部接口的独立凭证，不要与 JWT_SECRET 相同。
INTERNAL_SERVICE_TOKEN=再生成一个不同的32字节Hex密钥

# ── MySQL / Redis / RocketMQ / pgvector（docker compose 会自动启动，一般不用改）
MYSQL_PASSWORD=hellojobs123
APP_ROCKETMQ_ENABLED=true
# 只缓存解析已结束（parsed/failed）的候选人详情；列表和解析中状态不缓存。
STUDENT_DETAIL_CACHE_ENABLED=true
STUDENT_DETAIL_CACHE_TTL_SECONDS=300
STUDENT_DETAIL_CACHE_TTL_JITTER_SECONDS=120
STUDENT_DETAIL_CACHE_NULL_TTL_SECONDS=30
STUDENT_DETAIL_CACHE_SECOND_EVICT_DELAY_MS=1000
# 简历解析任务：MQ 不可用时由 Java 专用线程池接管；以下均可保持默认。
RESUME_PARSE_CORE_SIZE=2
RESUME_PARSE_MAX_SIZE=4
RESUME_PARSE_QUEUE_CAPACITY=100
RESUME_PARSE_LOCAL_MAX_ATTEMPTS=3
RESUME_PARSE_TIMEOUT_MINUTES=10
RESUME_PARSE_OUTBOX_BATCH_SIZE=50
RESUME_PARSE_OUTBOX_SCAN_MS=5000
RESUME_PARSE_RECOVERY_SCAN_MS=60000
PGVECTOR_USER=matchcv
PGVECTOR_PASSWORD=matchcv
PGVECTOR_DB=resume_vectors

# ── 种子管理员账号（Java 端启动时自动创建）─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=把你的管理员密码换掉

# ── 前端（本地 vite dev 模式使用，docker compose 生产模式不需要）──────────
# VITE_API_BASE_URL=http://localhost:8080
