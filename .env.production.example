# Copy to .env.production, fill every secret, and never commit the result.
APP_ENV=production
APP_SCHEME=https
APP_DOMAIN=matchcv.example.com

# Generate separately with: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters
INTERNAL_SERVICE_TOKEN=replace-with-another-64-random-hex-string

MYSQL_PASSWORD=replace-with-strong-mysql-password
PGVECTOR_USER=matchcv
PGVECTOR_PASSWORD=replace-with-strong-pgvector-password
PGVECTOR_DB=resume_vectors
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_STRUCTURED_METHOD=function_calling
LLM_DISABLE_THINKING=false

# Embedding
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RERANK_ENABLED=false

# OCR
OCR_ENABLED=true
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_FALLBACK_MODELS=Qwen/Qwen3-VL-8B-Instruct,PaddlePaddle/PaddleOCR-VL-1.5
OCR_API_KEY=
OCR_BASE_URL=

# Runtime tuning
APP_ROCKETMQ_ENABLED=true
CANDIDATE_DETAIL_CACHE_ENABLED=true
CANDIDATE_DETAIL_CACHE_TTL_SECONDS=300
CANDIDATE_DETAIL_CACHE_TTL_JITTER_SECONDS=120
CANDIDATE_DETAIL_CACHE_NULL_TTL_SECONDS=30
CANDIDATE_DETAIL_CACHE_SECOND_EVICT_DELAY_MS=1000
RESUME_PARSE_CORE_SIZE=2
RESUME_PARSE_MAX_SIZE=4
RESUME_PARSE_QUEUE_CAPACITY=100
RESUME_PARSE_LOCAL_MAX_ATTEMPTS=3
RESUME_PARSE_TIMEOUT_MINUTES=10
RESUME_PARSE_OUTBOX_BATCH_SIZE=50
RESUME_PARSE_OUTBOX_SCAN_MS=5000
RESUME_PARSE_RECOVERY_SCAN_MS=60000
SESSION_TTL_DAYS=7
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
