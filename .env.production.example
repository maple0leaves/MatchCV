# Copy this file to .env.production on the server. Never commit real secrets.
APP_ENV=production
APP_SCHEME=https
APP_DOMAIN=matchcv.example.com
SHARED_NETWORK=shared-platform
MATCHCV_DATA_DIR=/data/matchcv

# Generate these independently with: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters
INTERNAL_SERVICE_TOKEN=replace-with-another-64-random-hex-string

# These values must match the corresponding credentials in Project-Deployment/.env.
MYSQL_HOST=shared-mysql
MYSQL_PORT=3306
MYSQL_DB=hellojobs
MYSQL_USER=matchcv_app
MYSQL_PASSWORD=replace-with-strong-mysql-password
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_DATABASE=1
PGVECTOR_HOST=shared-pgvector
PGVECTOR_PORT=5432
PGVECTOR_DB=resume_vectors
PGVECTOR_USER=matchcv_vector
PGVECTOR_PASSWORD=replace-with-strong-pgvector-password
ROCKETMQ_NAME_SERVER=shared-rocketmq-namesrv:9876

# The seed administrator is created only on the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Primary LLM.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_STRUCTURED_METHOD=function_calling
LLM_DISABLE_THINKING=false
LLM_FORCE_FALLBACK=false

# Optional fallback LLM.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_STRUCTURED_METHOD=json_mode

# Embedding and OCR.
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
OCR_ENABLED=true
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_FALLBACK_MODELS=Qwen/Qwen3-VL-8B-Instruct,PaddlePaddle/PaddleOCR-VL-1.5
OCR_API_KEY=
OCR_BASE_URL=
RERANK_ENABLED=false

# Agent and background-task limits. Keep these conservative on a 2-core/8-GB host.
AGENT_RECURSION_LIMIT=12
SESSION_TTL_DAYS=7
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
APP_ROCKETMQ_ENABLED=true
ROCKETMQ_PRODUCER_GROUP=agent-recruit-producer
ROCKETMQ_RESUME_PARSE_TOPIC=agent-recruit-resume-parse
ROCKETMQ_RESUME_PARSE_CONSUMER_GROUP=agent-recruit-resume-parse-consumer
CANDIDATE_DETAIL_CACHE_ENABLED=true
CANDIDATE_DETAIL_CACHE_TTL_SECONDS=300
CANDIDATE_DETAIL_CACHE_TTL_JITTER_SECONDS=120
CANDIDATE_DETAIL_CACHE_NULL_TTL_SECONDS=30
CANDIDATE_DETAIL_CACHE_SECOND_EVICT_DELAY_MS=1000
RESUME_PARSE_CORE_SIZE=2
RESUME_PARSE_MAX_SIZE=4
RESUME_PARSE_QUEUE_CAPACITY=100
RESUME_PARSE_LOCAL_MAX_ATTEMPTS=3
RESUME_PARSE_TIMEOUT_MINUTES=10
RESUME_PARSE_OUTBOX_BATCH_SIZE=50
RESUME_PARSE_OUTBOX_SCAN_MS=5000
RESUME_PARSE_RECOVERY_SCAN_MS=60000
